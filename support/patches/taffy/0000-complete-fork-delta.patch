+    /// for parley line breaking.
+    pub fn exclusion_bands(&self, min_y: f32) -> Vec<(Range<f32>, [f32; 2])> {
+        if !self.has_active_floats(min_y) {
+            return Vec::new();
+        }
+        self.segments
+            .iter()
+            .filter(|seg| seg.y.end > min_y && (seg.insets[0] > 0.0 || seg.insets[1] > 0.0))
